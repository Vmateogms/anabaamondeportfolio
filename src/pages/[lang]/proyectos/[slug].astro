---
// src/pages/[lang]/proyectos/[slug].astro
import PocketBase from 'pocketbase';

const { lang, slug } = Astro.params;
const ALTURA_FILA = 350;

if (lang !== 'es' && lang !== 'en') {
    return Astro.redirect('/es/');
}

const pb = new PocketBase(import.meta.env.PUBLIC_POCKETBASE_URL);

let proyecto;
try {
    // getFirstListItem por slug; si no existe (o mandan el id viejo), probamos por id
    proyecto = await pb.collection('proyectos').getFirstListItem(
        pb.filter('slug = {:slug}', { slug })
    );
} catch (e) {
    try {
        proyecto = await pb.collection('proyectos').getOne(slug as string);
    } catch (e2) {
        return Astro.redirect(`/${lang}/proyectos`);
    }
}

const titulo = proyecto[`titulo_${lang}`];
const descripcion = proyecto[`descripcion_${lang}`]; // subtitulo corto, texto plano
const roles = proyecto[`roles_${lang}`]; // "Boom Operator · Direct Sound · Electric Dept"
const cuerpo = proyecto[`cuerpo_${lang}`]; // HTML enriquecido (editor de PocketBase)
const anio = proyecto.anio;

// campo "galeria" en PocketBase: archivo multiple (varias fotos del rodaje/proyecto)
const galeria: string[] = (proyecto.galeria || []).map((archivo: string) =>
    pb.files.getURL(proyecto, archivo)
);

const currentPath = Astro.url.pathname;
const linkES = currentPath.replace(`/${lang}`, '/es');
const linkEN = currentPath.replace(`/${lang}`, '/en');
---

<html lang={lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{titulo} - Ana Baamonde</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap');

        :root {
            --color-fondo: #f4f4f4;
            --texto: #000;
        }

        body {
            margin: 0;
            background-color: var(--color-fondo);
            font-family: 'Inter', sans-serif;
            color: var(--texto);
        }

        .cabecera {
            position: fixed;
            top: 0; left: 0; width: 100%;
            padding: 40px;
            display: flex;
            justify-content: space-between;
            z-index: 100;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 14px;
            box-sizing: border-box;
            background: linear-gradient(to bottom, #f4f4f4 0%, #f4f4f4 80%);
        }

        .idiomas a {
            text-decoration: none;
            color: #999;
            transition: color 0.3s;
            cursor: pointer;
        }
        .idiomas a:hover { color: #000; }

        .idiomas a.activo {
            color: #000;
            font-weight: bold;
            pointer-events: none;
        }

        .contenedor-principal {
            padding-top: 150px;
            padding-left: 40px;
            padding-right: 40px;
            padding-bottom: 100px;
            max-width: 1100px;
            margin: 0 auto;
        }

        .btn-volver {
            display: inline-block;
            text-decoration: none;
            color: #666;
            text-transform: uppercase;
            font-size: 12px;
            letter-spacing: 2px;
            margin-bottom: 60px;
            transition: color 0.3s;
            border-bottom: 1px solid transparent;
        }
        .btn-volver:hover {
            color: #000;
            border-bottom: 1px solid #000;
        }

        /* --- Cabecera del proyecto --- */
        .cabecera-proyecto {
            text-align: center;
            margin-bottom: 60px;
        }

        .cabecera-proyecto h1 {
            font-size: 2.2rem;
            font-weight: 600;
            margin: 0 0 4px 0;
            line-height: 1.2;
        }

        .anio-proyecto {
            display: block;
            font-size: 0.85rem;
            letter-spacing: 2px;
            color: #999;
            margin-bottom: 30px;
        }

        .descripcion-proyecto {
            max-width: 640px;
            margin: 0 auto 20px auto;
            font-size: 1rem;
            line-height: 1.6;
            font-weight: 300;
            color: #444;
        }

        .roles-proyecto {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: #888;
            font-weight: 600;
        }

        /* --- Galeria del proyecto (grid simple, sin masonry) --- */
        .galeria-proyecto {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin: 60px 0;
        }

        .galeria-proyecto .foto-item {
            aspect-ratio: 4 / 3;
            overflow: hidden;
            margin: 0;
        }

        /* la primera foto de la galeria a ancho completo, tipo "hero" del proyecto */
        .galeria-proyecto .foto-item.destacada {
            grid-column: 1 / -1;
            aspect-ratio: 16 / 9;
        }

        .galeria-proyecto img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            cursor: zoom-in;
            transition: transform 0.3s ease;
        }
        .galeria-proyecto img:hover {
            transform: scale(1.02);
        }

        /* --- Cuerpo libre (editor enriquecido de PocketBase) --- */
        .cuerpo-proyecto {
            font-size: 0.95rem;
            line-height: 1.7;
            font-weight: 300;
            color: #333;
        }

        .cuerpo-proyecto :global(p) {
            margin: 0 0 1.4rem 0;
        }

        .cuerpo-proyecto :global(h2),
        .cuerpo-proyecto :global(h3) {
            text-align: center;
            font-weight: 600;
            color: #666;
            font-size: 1rem;
            letter-spacing: 0.5px;
            margin: 3rem 0 1rem 0;
        }

        .cuerpo-proyecto :global(img) {
            width: 100%;
            height: auto;
            display: block;
            margin: 2.5rem 0;
        }

        @media (max-width: 900px) {
            .galeria-proyecto {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 600px) {
            .contenedor-principal {
                padding-top: 100px;
                padding-left: 20px;
                padding-right: 20px;
            }
            .cabecera-proyecto h1 { font-size: 1.6rem; }
            .galeria-proyecto {
                grid-template-columns: 1fr;
            }
            .galeria-proyecto .foto-item.destacada {
                aspect-ratio: 4 / 3;
            }
        }

        /* --- Lightbox (reutilizado de la galeria general) --- */
        .lightbox {
            display: none;
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.94);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            touch-action: none;
        }
        .lightbox.activo { display: flex; }
        .lightbox img {
            max-width: 92vw;
            max-height: 92vh;
            object-fit: contain;
            cursor: grab;
            user-select: none;
            -webkit-user-drag: none;
            will-change: transform;
        }
        .lightbox img.arrastrando { cursor: grabbing; }

        .lightbox-cerrar {
            position: fixed;
            top: 30px; right: 40px;
            width: 40px; height: 40px;
            display: flex; align-items: center; justify-content: center;
            font-size: 22px;
            background: none; border: none; color: #fff;
            cursor: pointer; z-index: 1001; opacity: 0.8;
            transition: opacity 0.2s;
        }
        .lightbox-cerrar:hover { opacity: 1; }

        .lightbox-nav {
            position: fixed;
            top: 50%;
            transform: translateY(-50%);
            width: 50px; height: 50px;
            display: flex; align-items: center; justify-content: center;
            font-size: 30px;
            background: none; border: none; color: #fff;
            cursor: pointer; z-index: 1001; opacity: 0.7;
            transition: opacity 0.2s;
        }
        .lightbox-nav:hover { opacity: 1; }
        .lightbox-anterior { left: 20px; }
        .lightbox-siguiente { right: 20px; }

        @media (max-width: 600px) {
            .lightbox-nav { width: 40px; height: 40px; font-size: 24px; }
            .lightbox-anterior { left: 5px; }
            .lightbox-siguiente { right: 5px; }
        }
    </style>
</head>
<body>

    <div class="cabecera">
        <div><a href={`/${lang}/`} style="text-decoration:none; color:inherit;">@klluevabacardi</a></div>
        <div class="idiomas">
            <a href={linkES} class={lang === 'es' ? 'activo' : ''}>ES</a>
            <span> | </span>
            <a href={linkEN} class={lang === 'en' ? 'activo' : ''}>EN</a>
        </div>
    </div>

    <main class="contenedor-principal">

        <a href={`/${lang}/proyectos`} class="btn-volver">{lang === 'es' ? '← Volver' : '← Back'}</a>

        <header class="cabecera-proyecto">
            <h1>{titulo}</h1>
            {anio && <span class="anio-proyecto">{anio}</span>}
            {descripcion && <p class="descripcion-proyecto">{descripcion}</p>}
            {roles && <p class="roles-proyecto">{roles}</p>}
        </header>

        {galeria.length > 0 && (
            <div class="galeria-proyecto">
                {galeria.map((url, indice) => (
                    <div class={`foto-item ${indice === 0 ? 'destacada' : ''}`}>
                        <img src={url} alt={titulo} data-lightbox="true" />
                    </div>
                ))}
            </div>
        )}

        {cuerpo && <div class="cuerpo-proyecto" set:html={cuerpo} />}

    </main>

    <div class="lightbox" id="lightbox">
        <button class="lightbox-cerrar" id="lightboxCerrar" aria-label="Cerrar">X</button>
        <button class="lightbox-nav lightbox-anterior" id="lightboxAnterior" aria-label={lang === 'es' ? 'Anterior' : 'Previous'}>‹</button>
        <img id="lightboxImg" src="" alt="" />
        <button class="lightbox-nav lightbox-siguiente" id="lightboxSiguiente" aria-label={lang === 'es' ? 'Siguiente' : 'Next'}>›</button>
    </div>
    <script>
        const lightbox = document.getElementById('lightbox') as HTMLDivElement;
        const lightboxImg = document.getElementById('lightboxImg') as HTMLImageElement;
        const btnCerrar = document.getElementById('lightboxCerrar') as HTMLButtonElement;
        const btnAnterior = document.getElementById('lightboxAnterior') as HTMLButtonElement;
        const btnSiguiente = document.getElementById('lightboxSiguiente') as HTMLButtonElement;

        const fotos: { src: string, alt: string }[] = [];
        let currentIndex = 0;
        let escala = 1;
        let posX = 0;
        let posY = 0;
        let arrastrando = false;
        let inicioX = 0;
        let inicioY = 0;
        let distanciaInicial = 0;
        let escalaInicial = 1;
        let ultimoTap = 0;
        let inicioToqueX = 0;
        let inicioToqueY = 0;
        let esPellizco = false;

        function actualizarTransform() {
            lightboxImg.style.transform = `translate(${posX}px, ${posY}px) scale(${escala})`;
        }

        function resetZoom() {
            escala = 1;
            posX = 0;
            posY = 0;
            actualizarTransform();
        }

        function abrirLightbox(indice: number) {
            currentIndex = indice;
            changePhoto();
            lightbox.classList.add('activo');
            document.body.style.overflow = 'hidden';
        }

        function changePhoto() {
            const foto = fotos[currentIndex];
            lightboxImg.src = foto.src;
            lightboxImg.alt = foto.alt;
            resetZoom();
        }

        function showNext() {
            currentIndex = (currentIndex + 1) % fotos.length;
            changePhoto();
        }

        function showBefore() {
            currentIndex = (currentIndex - 1 + fotos.length) % fotos.length;
            changePhoto();
        }

        function closeLightbox() {
            lightbox.classList.remove('activo');
            document.body.style.overflow = '';
            lightboxImg.src = '';
        }

        function distanceBetweenFingers(touches: TouchList) {
            const dx = touches[0].clientX - touches[1].clientX;
            const dy = touches[0].clientY - touches[1].clientY;
            return Math.sqrt(dx * dx + dy * dy);
        }

        document.querySelectorAll<HTMLImageElement>('[data-lightbox]').forEach((img, indice) => {
            fotos.push({ src: img.src, alt: img.alt });
            img.addEventListener('click', () => abrirLightbox(indice));
        });

        if (fotos.length <= 1) {
            btnAnterior.style.display = 'none';
            btnSiguiente.style.display = 'none';
        }

        btnCerrar.addEventListener('click', closeLightbox);
        btnAnterior.addEventListener('click', (e) => { e.stopPropagation(); showBefore(); });
        btnSiguiente.addEventListener('click', (e) => { e.stopPropagation(); showNext(); });

        lightbox.addEventListener('click', (e) => {
            if (e.target === lightbox) closeLightbox();
        });

        document.addEventListener('keydown', (e) => {
            if (!lightbox.classList.contains('activo')) return;
            if (e.key === 'Escape') closeLightbox();
            if (e.key === 'ArrowRight') showNext();
            if (e.key === 'ArrowLeft') showBefore();
        });

        lightboxImg.addEventListener('wheel', (e) => {
            e.preventDefault();
            const delta = e.deltaY > 0 ? -0.2 : 0.2;
            escala = Math.min(Math.max(1, escala + delta), 5);
            if (escala === 1) { posX = 0; posY = 0; }
            actualizarTransform();
        });

        lightboxImg.addEventListener('dblclick', () => {
            escala = escala === 1 ? 2.5 : 1;
            if (escala === 1) { posX = 0; posY = 0; }
            actualizarTransform();
        });

        lightboxImg.addEventListener('mousedown', (e) => {
            if (escala === 1) return;
            arrastrando = true;
            lightboxImg.classList.add('arrastrando');
            inicioX = e.clientX - posX;
            inicioY = e.clientY - posY;
        });

        window.addEventListener('mousemove', (e) => {
            if (!arrastrando) return;
            posX = e.clientX - inicioX;
            posY = e.clientY - inicioY;
            actualizarTransform();
        });

        window.addEventListener('mouseup', () => {
            arrastrando = false;
            lightboxImg.classList.remove('arrastrando');
        });

        lightboxImg.addEventListener('touchstart', (e) => {
            if (e.touches.length === 2) {
                esPellizco = true;
                distanciaInicial = distanceBetweenFingers(e.touches);
                escalaInicial = escala;
            } else if (e.touches.length === 1) {
                esPellizco = false;
                inicioToqueX = e.touches[0].clientX;
                inicioToqueY = e.touches[0].clientY;
                if (escala > 1) {
                    arrastrando = true;
                    inicioX = e.touches[0].clientX - posX;
                    inicioY = e.touches[0].clientY - posY;
                }
            }
        });

        lightbox.addEventListener('touchmove', (e) => {
            if (e.touches.length === 2) {
                e.preventDefault();
                const distanciaActual = distanceBetweenFingers(e.touches);
                escala = Math.min(Math.max(1, escalaInicial * (distanciaActual / distanciaInicial)), 5);
                actualizarTransform();
            } else if (e.touches.length === 1 && arrastrando) {
                posX = e.touches[0].clientX - inicioX;
                posY = e.touches[0].clientY - inicioY;
                actualizarTransform();
            }
        });

        lightboxImg.addEventListener('touchend', (e) => {
            arrastrando = false;
            if (esPellizco) { esPellizco = false; return; }

            const toque = e.changedTouches[0];
            const deltaX = toque.clientX - inicioToqueX;
            const deltaY = toque.clientY - inicioToqueY;

            if (escala === 1 && Math.abs(deltaX) > 60 && Math.abs(deltaY) < 60) {
                deltaX > 0 ? showBefore() : showNext();
                return;
            }

            const ahora = Date.now();
            if (ahora - ultimoTap < 300) {
                escala = escala === 1 ? 2.5 : 1;
                if (escala === 1) { posX = 0; posY = 0; }
                actualizarTransform();
            }
            ultimoTap = ahora;
        });
    </script>

</body>
</html>