---
interface Props {
    bloques: any[];
    titulo: string;
}
const { bloques, titulo } = Astro.props;
---

<div class="bloques">
    {bloques.map((b) => (
        <section class={`bloque bloque-${b.tipo}`}>

            {b.tipo === 'texto' && (
                <div class={`texto ${b.alineacion === 'centro' ? 'centrado' : ''}`} set:html={b.texto} />
            )}

            {b.tipo === 'imagenes' && (
                <div class={`imagenes ${b.disposicion || 'fila'} ${b.urls.length > 1 ? 'varias' : 'unica'}`}>
                    {b.urls.map((url: string) =>
                        b.enlace_url ? (
                            <a href={b.enlace_url} target="_blank" rel="noopener noreferrer">
                                <img src={url} alt={titulo} />
                            </a>
                        ) : (
                            <img src={url} alt={titulo} data-lightbox="true" />
                        )
                    )}
                </div>
            )}

            {b.tipo === 'galeria' && (
                <div class="galeria">
                    {b.urls.map((url: string) => (
                        <img src={url} alt={titulo} data-lightbox="true" loading="lazy" />
                    ))}
                </div>
            )}

            {b.tipo === 'video' && b.videoId && (
                <div class="video">
                    <iframe
                        src={`https://www.youtube-nocookie.com/embed/${b.videoId}`}
                        title={titulo}
                        loading="lazy"
                        allow="encrypted-media; picture-in-picture; fullscreen"
                        allowfullscreen
                    ></iframe>
                </div>
            )}

            {b.tipo === 'boton' && (
                <a class="boton" href={b.urlArchivo || b.enlace_url} target="_blank" rel="noopener noreferrer">
                    {b.etiqueta}
                </a>
            )}

            {b.tipo === 'texto_imagen' && (
                <div class={`texto-imagen lado-${b.lado || 'derecha'}`}>
                    <div class="texto" set:html={b.texto} />
                    <div class="fotos">
                        {b.urls.map((url: string) => (
                            <img src={url} alt={titulo} data-lightbox="true" />
                        ))}
                    </div>
                </div>
            )}

            {b.tipo === 'espacio' && <div class={`espacio espacio-${b.altura || 'medio'}`}></div>}

        </section>
    ))}
</div>

<style>
    .bloque { margin: 0 0 40px 0; }

    .texto { font-size: 0.95rem; line-height: 1.7; font-weight: 300; color: #333; }
    .texto.centrado { text-align: center; max-width: 640px; margin-inline: auto; }
    .texto :global(p) { margin: 0 0 1.4rem 0; }
    .texto :global(h2), .texto :global(h3) {
        text-align: center; font-weight: 600; color: #666;
        font-size: 1rem; letter-spacing: 0.5px; margin: 3rem 0 1rem 0;
    }

    /* imágenes en su proporción original, sin recorte (bloques de 1 sola foto) */
    .imagenes { display: flex; gap: 10px; align-items: flex-start; }
    .imagenes.apiladas { flex-direction: column; }
    .imagenes.fila > * { flex: 1 1 0; min-width: 0; }
    .imagenes img { width: 100%; height: auto; display: block; }
    .imagenes img[data-lightbox] { cursor: zoom-in; }

    /* varias fotos en fila: misma altura, recortadas para que la fila quede alineada */
    .imagenes.fila.varias { align-items: stretch; }

    /* caso A: foto suelta, sin enlace -> el <img> es el hijo directo */
    .imagenes.fila.varias > img {
        height: 400px;
        width: 100%;
        object-fit: cover;
        display: block;
    }

    /* caso B: foto con enlace -> el hijo directo es el <a>, el <img> va dentro */
    .imagenes.fila.varias > a {
        height: 400px;
        overflow: hidden;
        display: block;
    }
    .imagenes.fila.varias > a img {
        height: 100%;
        width: 100%;
        object-fit: cover;
        display: block;
    }

    .galeria { columns: 3 240px; column-gap: 10px; }
    .galeria img {
        width: 100%; height: auto; display: block;
        margin-bottom: 10px; break-inside: avoid; cursor: zoom-in;
    }

    .video { aspect-ratio: 16 / 9; }
    .video iframe { width: 100%; height: 100%; border: 0; }

    .bloque-boton { text-align: center; }
    .boton {
        display: inline-block; background: #000; color: #fff; text-decoration: none;
        padding: 12px 32px; border-radius: 999px; font-size: 0.85rem; font-weight: 600;
        letter-spacing: 1px; text-transform: uppercase; transition: opacity 0.3s;
    }
    .boton:hover { opacity: 0.75; }

    .texto-imagen { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; }
    .texto-imagen.lado-izquierda .fotos { order: -1; }
    .fotos { display: flex; flex-direction: column; gap: 10px; }
    .fotos img { width: 100%; height: auto; display: block; cursor: zoom-in; }

    .espacio-pequeno { height: 20px; }
    .espacio-medio { height: 60px; }
    .espacio-grande { height: 120px; }

    @media (max-width: 600px) {
        .imagenes.fila { flex-direction: column; }
        .imagenes.fila.varias > img,
        .imagenes.fila.varias > a {
            height: 260px;
        }
        .texto-imagen { grid-template-columns: 1fr; gap: 20px; }
    }
</style>